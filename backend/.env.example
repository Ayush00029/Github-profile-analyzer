# GitHub personal access token — raises the API rate limit from 60/hr to 5,000/hr.
# Create one at https://github.com/settings/tokens
#   - Classic token: no scopes needed for public data (optionally "public_repo").
#   - Fine-grained token: read-only, "Public Repositories" access is enough.
GITHUB_TOKEN=your_token_here

# Port the API listens on
PORT=5000

# In-memory cache time-to-live, in seconds (per username, per route)
CACHE_TTL=600
